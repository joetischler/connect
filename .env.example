# Database
DATABASE_URL=postgresql://connect:connect@localhost:5432/connect

# NATS
NATS_URL=nats://localhost:4222

# Object Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=connect
S3_SECRET_KEY=connectpass
S3_BUCKET=connect-raw-messages

# Server
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Observability (optional)
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# LLM (optional)
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
